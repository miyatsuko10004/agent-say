#!/usr/bin/env python3
"""
agent-say: Fast, distraction-free voice summary notification for AI agents
(Antigravity, Claude Code, Cursor, Codex, etc.)

Features:
- Markdown/URL/code artifact sanitizer to avoid noisy voice reading
- Ultra-low latency, non-blocking background playback
- Automatic audio device targeting (e.g. Shokz OpenMove bone conduction)
- Multi-engine architecture (macOS say, with extensibility for Neural TTS)
"""

import sys
import re
import os
import subprocess

def clean_text(text: str) -> str:
    # URL removal
    text = re.sub(r'https?://\S+', '', text)
    # Markdown link [text](url) -> text
    text = re.sub(r'\[([^\]]+)\]\([^)]+\)', r'\1', text)
    # Code block ```...```
    text = re.sub(r'```[\s\S]*?```', '', text)
    # Inline code `...` -> ...
    text = re.sub(r'`([^`]+)`', r'\1', text)
    # Headings and list markers (#, ##, -, *, etc.)
    text = re.sub(r'^[#>\-\*\+\d\.]+\s*', '', text, flags=re.MULTILINE)
    # Bold / italic / strikethrough (*, _, ~)
    text = re.sub(r'[*_~]', '', text)
    # File paths (file:///path/to/file.ext -> file.ext)
    text = re.sub(r'file:///[^\s/]+/([^\s/]+)', r'\1', text)
    # Extra whitespace and newline normalization
    text = re.sub(r'\s+', ' ', text).strip()
    
    # Text length safeguard (target 50-180 chars for voice digest)
    if len(text) > 200:
        sentences = re.split(r'(?<=[。！？\n])', text)
        shortened = ""
        for s in sentences:
            if len(shortened) + len(s) <= 180:
                shortened += s
            else:
                break
        if shortened:
            text = shortened
        else:
            text = text[:180] + "、以下省略します。"
            
    return text

def get_audio_device_id(pattern: str):
    """
    Get audio device ID from macOS say -a '?' matching device pattern.
    """
    try:
        out = subprocess.check_output(["say", "-a", "?"], text=True, stderr=subprocess.DEVNULL)
        for line in out.splitlines():
            line = line.strip()
            if not line:
                continue
            parts = line.split(None, 1)
            if len(parts) >= 2:
                dev_id, dev_name = parts[0], parts[1]
                if re.search(pattern, dev_name, re.IGNORECASE):
                    return dev_id
    except Exception:
        pass
    return None

def speak_macos(text: str, voice: str, rate: str, device_pattern: str):
    # Kill any ongoing say process to avoid overlapping voices
    subprocess.run(["killall", "say"], stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)

    device_id = None
    if device_pattern:
        device_id = get_audio_device_id(device_pattern)

    cmd = ["say", "-v", voice, "-r", rate]
    if device_id:
        cmd.extend(["-a", device_id])
    cmd.append(text)

    # Detached non-blocking execution
    subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def main():
    if len(sys.argv) > 1:
        if sys.argv[1] == "--test":
            input_text = "音声通知のテストです。正常に動作しています。"
        elif sys.argv[1] in ("-h", "--help"):
            print("Usage: agent-say <text> | echo <text> | agent-say")
            print("Environment variables:")
            print("  AGENT_VOICE: Voice name (default: Kyoko)")
            print("  AGENT_VOICE_RATE: Speech rate (default: 210)")
            print("  AGENT_AUDIO_DEVICE: Output device regex (default: OpenMove|AfterShokz|Shokz)")
            sys.exit(0)
        else:
            input_text = " ".join(sys.argv[1:])
    else:
        if not sys.stdin.isatty():
            input_text = sys.stdin.read()
        else:
            print("Usage: agent-say <text> | echo <text> | agent-say")
            sys.exit(0)

    cleaned = clean_text(input_text)
    if not cleaned:
        sys.exit(0)

    voice = os.environ.get("AGENT_VOICE", "Kyoko")
    rate = os.environ.get("AGENT_VOICE_RATE", "210")
    preferred_device_pattern = os.environ.get("AGENT_AUDIO_DEVICE", r"OpenMove|AfterShokz|Shokz")

    speak_macos(cleaned, voice, rate, preferred_device_pattern)

if __name__ == "__main__":
    main()
